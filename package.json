{
  "name": "arsos-website",
  "private": true,
  "version": "1.0.0",
  "description": "Production-ready ARSOS MERN website",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "seed": "npm run seed --workspace server"
  },
  "workspaces": ["client", "server"],
  "devDependencies": {"concurrently": "^9.2.1"},
  "engines": {"node": ">=20"}
}
