# Runtime
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (optional in development; the API safely uses volatile memory when omitted)
MONGODB_URI=mongodb://127.0.0.1:27017/arsos

# Admin — replace every value before deployment
ADMIN_EMAIL=admin@example.invalid
# Generate with: npm run seed --workspace server -- --password "your-long-password"
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_A_BCRYPT_HASH
JWT_SECRET=replace-with-at-least-32-random-characters

# Public company details — placeholders are shown when omitted
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=

